# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# From Neon — remember to change postgresql:// to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-long-random-string

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# The frontend's dev server origin — used for CORS.
FRONTEND_ORIGIN=http://localhost:5173